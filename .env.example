# PayPerWatch environment. Copy to .env.local and fill in the blanks.
# Never commit .env or .env.local: they hold private keys.

# ── Network ────────────────────────────────────────────────────────────────
# Defaults target Arc mainnet and the live contract in contracts/deployments.json,
# so these can stay commented out. For Arc Testnet, use the testnet branch or set:
#   NEXT_PUBLIC_ARC_CHAIN_ID=5042002
#   NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.io
#   NEXT_PUBLIC_ARC_EXPLORER=https://explorer.testnet.arc.io
#   NEXT_PUBLIC_PPW_CONTRACT=0x9da4403e212804081cd0d5bab0ea9d0bcc3d96e1
#   NEXT_PUBLIC_PPW_DEPLOY_BLOCK=68679534
# NEXT_PUBLIC_ARC_CHAIN_ID=5042
# NEXT_PUBLIC_ARC_RPC=https://rpc.mainnet.arc.io
# NEXT_PUBLIC_ARC_EXPLORER=https://explorer.arc.io
# NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# NEXT_PUBLIC_PPW_CONTRACT=0xb5AEE9b6421fdDAe63F31E5A7B2E4E4B54A51eF4
# NEXT_PUBLIC_PPW_DEPLOY_BLOCK=27732474
# Earlier contracts viewers can still withdraw from, comma-separated, or "none".
NEXT_PUBLIC_PPW_LEGACY_CONTRACTS=none

# ── Site ───────────────────────────────────────────────────────────────────
# Public https URL of this deployment. Baked in at build time; sign-in checks this domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: WalletConnect (cloud.reown.com) for mobile wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Shown on the Terms and Privacy pages. The contact address receives copyright complaints.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_LEGAL_UPDATED=2026-10-25

# ── Secrets (required) ─────────────────────────────────────────────────────
# 32+ random characters each, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
CRON_SECRET=
# Wallet that settles receipts onchain. Needs a little USDC on Arc for gas.
SETTLER_PRIVATE_KEY=

# ── Storage ────────────────────────────────────────────────────────────────
# local (disk under ./data, default) | r2 | supabase | livepeer | pinata
NEXT_PUBLIC_STORAGE_PROVIDER=local
# PPW_DATA_DIR=./data

# Vercel setup: MongoDB Atlas for metadata, Cloudflare R2 for videos (see README).
MONGODB_URI=
MONGODB_DB=payperwatch
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=   # only for local S3-compatible test servers

# Other storage providers, if chosen above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LIVEPEER_API_KEY=
PINATA_JWT=
PINATA_GATEWAY=

# ── Mainnet soft-launch switches ───────────────────────────────────────────
# Unset uses the network default (shown). Set on/off to override.
# NEXT_PUBLIC_DEPOSIT_CAP_USDC=50   # per-wallet cap in USDC; 0 = none (testnet default: 0)
# CONTENT_REVIEW=off                # review worker: originality check, transcripts, encrypted streaming (testnet: on)
# NEXT_PUBLIC_AGENT_API=off         # paid agent transcripts over x402 (testnet: on)

# ── Review worker and agent API (only when turned on above) ────────────────
REVIEW_WORKER_SECRET=
# Platform agent account: receives agents' x402 payments via Circle Gateway, then pays creators
# through the contract like a viewer.
AGENT_PRIVATE_KEY=
# GATEWAY_FACILITATOR_URL=https://gateway-api.circle.com

# ── Health check (/api/health) ─────────────────────────────────────────────
# HEALTH_MIN_SETTLER_USDC=1
# HEALTH_MAX_SETTLE_HOURS=26

# ── Scripts ────────────────────────────────────────────────────────────────
# npm run seed: publishes 3 Creative Commons films from this wallet.
SEED_CREATOR_PRIVATE_KEY=
# scripts/agent-demo.ts: an outside agent's own wallet (npx tsx scripts/agent-demo.ts new).
TEST_AGENT_PRIVATE_KEY=
# PPW_URL=https://ppv-studio.vercel.app

# Simulated chain, for scripts/e2e-mock.ts only.
NEXT_PUBLIC_MOCK_MODE=false
