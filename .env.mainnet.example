# PayPerWatch on Arc MAINNET. Real USDC.
# Copy these into the mainnet Vercel project (Settings > Environment Variables), never into the
# testnet project. Every secret here must be NEW: don't reuse a testnet key, database or bucket.
# Checklist and order: MAINNET.md. Check the result with `npx tsx scripts/mainnet-preflight.ts`.

# ---------- Chain (public) ----------
# Verified 2026-10-24 against rpc.mainnet.arc.io: chain 5042, USDC at 0x3600…0000 with 6 decimals.
NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_RPC=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER=https://explorer.arc.io
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Filled in after the mainnet contract is deployed.
NEXT_PUBLIC_PPW_CONTRACT=
NEXT_PUBLIC_PPW_DEPLOY_BLOCK=
# No earlier mainnet deployments. Must be set: unset falls back to the testnet contracts.
NEXT_PUBLIC_PPW_LEGACY_CONTRACTS=none

NEXT_PUBLIC_APP_URL=https://your-mainnet-domain
NEXT_PUBLIC_MOCK_MODE=false
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------- Mainnet switches ----------
# Review worker (originality check, transcripts, encrypted HLS): off until a worker runs 24/7.
# Turn it back on with CONTENT_REVIEW=on plus a new REVIEW_WORKER_SECRET.
CONTENT_REVIEW=off
# Paid agent transcripts: Circle Gateway nanopayments aren't on Arc mainnet yet, and there are no
# transcripts while the worker is off.
NEXT_PUBLIC_AGENT_API=off
# Soft launch: most one wallet can keep in the contract, in USDC (enforced in the app only). 0 = none.
NEXT_PUBLIC_DEPOSIT_CAP_USDC=50

# ---------- Who runs it (terms, privacy, copyright complaints) ----------
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_UPDATED=

# ---------- Storage: a NEW bucket, with CORS GET allowed from NEXT_PUBLIC_APP_URL ----------
NEXT_PUBLIC_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------- Server only ----------
# A NEW database (separate Atlas project or at least a separate db name).
MONGODB_URI=
MONGODB_DB=ppw_mainnet
# openssl rand -hex 32 (each one new)
SESSION_SECRET=
CRON_SECRET=
# Hot key that only pays gas for settleBatch. It is NOT the contract owner or the fee recipient.
# Keep $5–20 of USDC in it.
SETTLER_PRIVATE_KEY=

# Uptime monitor thresholds for /api/health. With an hourly cron-job.org sweep, use 2.
HEALTH_MIN_SETTLER_USDC=2
HEALTH_MAX_SETTLE_HOURS=2

# Not used on mainnet while the features above are off. Leave unset.
# AGENT_PRIVATE_KEY=
# REVIEW_WORKER_SECRET=
